{
  "appId": "com.voxia.app",
  "appName": "VoxiaApp",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": false,
      "backgroundColor": "#08080d",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    }
  },
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  }
}
